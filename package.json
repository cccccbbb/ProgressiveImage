{
  "name": "hilbert-vue-progressive-image",
  "version": "0.1.0",
  "description": "Vue 3 渐进加载图片组件：模糊低清图 / 主色占位 / 骨架屏三种占位策略",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cccccbbb/ProgressiveImage.git"
  },
  "homepage": "https://cccccbbb.github.io/ProgressiveImage/",
  "bugs": {
    "url": "https://github.com/cccccbbb/ProgressiveImage/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "image",
    "progressive-image",
    "lazy-load",
    "thumbhash",
    "blurhash",
    "placeholder"
  ],
  "main": "./lib/index.umd.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.umd.cjs"
    },
    "./style.css": "./lib/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "gen:photos": "node scripts/gen-photos.mjs",
    "prebuild": "npm run gen:photos",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "prepack": "npm run build:lib",
    "prepare": "npm run build:lib",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "jpeg-js": "^0.4.4",
    "thumbhash": "^0.1.1",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  }
}
